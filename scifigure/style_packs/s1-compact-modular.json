{
  "id": "s1-compact-modular",
  "display_name": "S1 CATDM Reference Scientific Style",
  "reference_template": "CATDM / CCoAt",
  "template_locked": true,
  "layout": "compact_modular",
  "font_family": "Arial, Noto Sans, sans-serif",
  "title_font_family": "Georgia, Times New Roman, serif",
  "text_primary": "#171613",
  "text_secondary": "#5F5E54",
  "canvas_background": "#FFFFFF",
  "group_fill_opacity": 0.06,
  "group_dashed": true,
  "node_radius": 7,
  "node_border_width": 1.35,
  "density": "high",
  "semantic_colors": {
    "input": {"fill": "#FEFEFE", "stroke": "#83ADD5", "text": "#171613"},
    "data": {"fill": "#FEFEFE", "stroke": "#83ADD5", "text": "#171613"},
    "representation": {"fill": "#FCFDF9", "stroke": "#979E88", "text": "#171613"},
    "process": {"fill": "#FEFEFE", "stroke": "#A0A09F", "text": "#171613"},
    "fusion": {"fill": "#FFFDF8", "stroke": "#E2B75A", "text": "#171613"},
    "training": {"fill": "#FFFCF9", "stroke": "#E4845B", "text": "#171613"},
    "loss": {"fill": "#FFFCF9", "stroke": "#E4845B", "text": "#171613"},
    "output": {"fill": "#FEFEFE", "stroke": "#A0A09F", "text": "#171613"},
    "graph": {"fill": "#FEFCFF", "stroke": "#9D86C7", "text": "#171613"},
    "static": {"fill": "#FEFEFE", "stroke": "#A0A09F", "text": "#171613"}
  },
  "group_colors": ["#FFFFFF", "#FEFEFE", "#FFFFFF", "#FEFEFE", "#FFFFFF", "#FEFEFE"],
  "glyph_palette": ["#B0D2E0", "#37AB9D", "#C7D8B2", "#F8C08D", "#C8B7DA", "#F3DFA4"],
  "edge_styles": {
    "data_flow": {"color": "#83ADD5", "width": 1.8, "dashed": false},
    "control_flow": {"color": "#595959", "width": 1.9, "dashed": false},
    "residual": {"color": "#9D86C7", "width": 1.6, "dashed": false},
    "skip": {"color": "#A0A09F", "width": 1.3, "dashed": true},
    "feedback": {"color": "#9D86C7", "width": 1.5, "dashed": true},
    "training_only": {"color": "#E4845B", "width": 1.55, "dashed": true},
    "reference": {"color": "#B0B0AF", "width": 1.15, "dashed": true},
    "gradient": {"color": "#E4845B", "width": 1.5, "dashed": true}
  },
  "template_rules": {
    "major_regions": "white with gray dashed borders",
    "main_flow": "top horizontal overview",
    "detail_panels": "bottom module decompositions",
    "color_usage": "local accents only",
    "forbid_large_colored_regions": true
  }
}
