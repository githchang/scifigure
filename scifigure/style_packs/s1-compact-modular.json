{
  "id": "s1-compact-modular",
  "display_name": "S1 CATDM Reference Scientific Style",
  "reference_template": "CATDM / CCoAt",
  "template_locked": true,
  "layout": "compact_modular",
  "font_family": "Arial, Noto Sans, sans-serif",
  "title_font_family": "Georgia, Times New Roman, serif",
  "text_primary": "#111827",
  "text_secondary": "#475569",
  "canvas_background": "#FFFFFF",
  "group_fill_opacity": 0.22,
  "group_dashed": true,
  "node_radius": 8,
  "node_border_width": 1.8,
  "density": "high",
  "semantic_colors": {
    "input": {"fill": "#E7F2FF", "stroke": "#3B82F6", "text": "#111827"},
    "data": {"fill": "#E7F2FF", "stroke": "#3B82F6", "text": "#111827"},
    "representation": {"fill": "#EAF7DE", "stroke": "#65A30D", "text": "#111827"},
    "process": {"fill": "#F1F5F9", "stroke": "#64748B", "text": "#111827"},
    "fusion": {"fill": "#FFF0D6", "stroke": "#F59E0B", "text": "#111827"},
    "training": {"fill": "#FFE4D8", "stroke": "#F97316", "text": "#111827"},
    "loss": {"fill": "#FFE4D8", "stroke": "#F97316", "text": "#111827"},
    "output": {"fill": "#DDF7F2", "stroke": "#14B8A6", "text": "#111827"},
    "graph": {"fill": "#EFE7FF", "stroke": "#8B5CF6", "text": "#111827"},
    "static": {"fill": "#EEF2F7", "stroke": "#64748B", "text": "#111827"}
  },
  "group_colors": ["#EDF6FF", "#F0FAE8", "#FFF5E5", "#F5EEFF", "#FFF0EA", "#E9FAF7"],
  "glyph_palette": ["#2563EB", "#0F9F8F", "#65A30D", "#F59E0B", "#8B5CF6", "#EC4899"],
  "edge_styles": {
    "data_flow": {"color": "#2563EB", "width": 2.2, "dashed": false},
    "control_flow": {"color": "#334155", "width": 2.3, "dashed": false},
    "residual": {"color": "#8B5CF6", "width": 2.0, "dashed": false},
    "skip": {"color": "#64748B", "width": 1.7, "dashed": true},
    "feedback": {"color": "#7C3AED", "width": 1.9, "dashed": true},
    "training_only": {"color": "#F97316", "width": 2.0, "dashed": true},
    "reference": {"color": "#94A3B8", "width": 1.5, "dashed": true},
    "gradient": {"color": "#EA580C", "width": 1.9, "dashed": true}
  },
  "template_rules": {
    "major_regions": "white with gray dashed borders",
    "main_flow": "top horizontal overview",
    "detail_panels": "bottom module decompositions",
    "color_usage": "bright local accents with lightly tinted modules",
    "forbid_large_colored_regions": true
  }
}
