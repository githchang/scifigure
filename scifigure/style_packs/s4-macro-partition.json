{
  "id": "s4-macro-partition",
  "display_name": "S4 GTM / Fourier Panel Style",
  "reference_template": "GTM / Fourier",
  "template_locked": true,
  "layout": "macro_partition",
  "font_family": "Times New Roman, Georgia, serif",
  "title_font_family": "Times New Roman, Georgia, serif",
  "text_primary": "#1C1C1C",
  "text_secondary": "#555A61",
  "canvas_background": "#FFFFFF",
  "group_fill_opacity": 0.10,
  "group_dashed": false,
  "node_radius": 3,
  "node_border_width": 1.25,
  "density": "medium_high",
  "semantic_colors": {
    "input": {"fill": "#FFF5D6", "stroke": "#D9B345", "text": "#1C1C1C"},
    "data": {"fill": "#FFF5D6", "stroke": "#D9B345", "text": "#1C1C1C"},
    "representation": {"fill": "#E7F3D4", "stroke": "#8CB662", "text": "#1C1C1C"},
    "process": {"fill": "#E9EEF8", "stroke": "#7994B9", "text": "#1C1C1C"},
    "fusion": {"fill": "#E3F4F5", "stroke": "#49A2AA", "text": "#1C1C1C"},
    "training": {"fill": "#F3E9DD", "stroke": "#BB8C61", "text": "#1C1C1C"},
    "loss": {"fill": "#F3E9DD", "stroke": "#BB8C61", "text": "#1C1C1C"},
    "output": {"fill": "#DFF3ED", "stroke": "#52A69A", "text": "#1C1C1C"},
    "graph": {"fill": "#E8EDF7", "stroke": "#6E89AF", "text": "#1C1C1C"},
    "static": {"fill": "#F5F5F5", "stroke": "#868686", "text": "#1C1C1C"}
  },
  "group_colors": ["#FFFDF6", "#F8FCF3", "#F5FAFC", "#F7FAFD", "#FCFCFC", "#F7FBF9"],
  "glyph_palette": ["#6687BA", "#7AAA69", "#D6B84D", "#53ABB2", "#A77FAE", "#E2A06E"],
  "edge_styles": {
    "data_flow": {"color": "#1D1D1D", "width": 1.7, "dashed": false},
    "control_flow": {"color": "#111111", "width": 1.9, "dashed": false},
    "residual": {"color": "#6687BA", "width": 1.45, "dashed": false},
    "skip": {"color": "#7A7A7A", "width": 1.2, "dashed": true},
    "feedback": {"color": "#6687BA", "width": 1.4, "dashed": true},
    "training_only": {"color": "#BB8C61", "width": 1.4, "dashed": true},
    "reference": {"color": "#8795A5", "width": 1.1, "dashed": true},
    "gradient": {"color": "#BB8C61", "width": 1.4, "dashed": true}
  },
  "template_rules": {
    "major_regions": "left model flow and right explanatory panels",
    "panel_border": "cyan blue",
    "input_palette": "cream yellow",
    "backbone_palette": "soft green",
    "analysis_palette": "blue cyan"
  }
}
