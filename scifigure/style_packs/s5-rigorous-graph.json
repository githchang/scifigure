{
  "id": "s5-rigorous-graph",
  "display_name": "S5 Rigorous Relation Graph",
  "layout": "rigorous_graph",
  "font_family": "Georgia, Times New Roman, serif",
  "title_font_family": "Georgia, Times New Roman, serif",
  "text_primary": "#121212",
  "text_secondary": "#4F4F4F",
  "canvas_background": "#FFFFFF",
  "group_fill_opacity": 0.10,
  "group_dashed": true,
  "node_radius": 7,
  "node_border_width": 1.7,
  "density": "high",
  "semantic_colors": {
    "input": {"fill": "#E7EEF7", "stroke": "#667C95"},
    "data": {"fill": "#E7EEF7", "stroke": "#667C95"},
    "representation": {"fill": "#E8F1E4", "stroke": "#6F8564"},
    "process": {"fill": "#EEE9F5", "stroke": "#77658B"},
    "fusion": {"fill": "#F7EAD8", "stroke": "#9B7545"},
    "training": {"fill": "#F4E3E3", "stroke": "#945B5B"},
    "loss": {"fill": "#F4E3E3", "stroke": "#945B5B"},
    "output": {"fill": "#E5F0EE", "stroke": "#5D817A"},
    "graph": {"fill": "#E9E4F2", "stroke": "#6B5A82"},
    "static": {"fill": "#ECECEC", "stroke": "#707070"}
  },
  "group_colors": ["#F2F2F2", "#EEF3F8", "#F1F5EE", "#F5F0E9", "#F2ECF5", "#EEF5F4"],
  "edge_styles": {
    "data_flow": {"color": "#111111", "width": 2.0, "dashed": false},
    "control_flow": {"color": "#000000", "width": 2.3, "dashed": false},
    "residual": {"color": "#4B3D5C", "width": 1.7, "dashed": false},
    "skip": {"color": "#555555", "width": 1.5, "dashed": false},
    "feedback": {"color": "#606060", "width": 1.6, "dashed": true},
    "training_only": {"color": "#8F5E39", "width": 1.6, "dashed": true},
    "reference": {"color": "#777777", "width": 1.3, "dashed": true},
    "gradient": {"color": "#8F4E4E", "width": 1.6, "dashed": true}
  }
}
