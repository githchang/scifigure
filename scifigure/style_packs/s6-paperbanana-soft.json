{
  "id": "s6-paperbanana-soft",
  "display_name": "S6 PaperBanana Soft Scientific",
  "layout": "paperbanana_soft",
  "font_family": "Arial, Noto Sans, sans-serif",
  "title_font_family": "Arial, Noto Sans, sans-serif",
  "text_primary": "#1F2937",
  "text_secondary": "#5B6775",
  "canvas_background": "#FFFFFF",
  "group_fill_opacity": 0.50,
  "group_dashed": false,
  "node_radius": 14,
  "node_border_width": 1.4,
  "density": "medium",
  "semantic_colors": {
    "input": {"fill": "#EFF6FF", "stroke": "#7CA5D6"},
    "data": {"fill": "#EFF6FF", "stroke": "#7CA5D6"},
    "representation": {"fill": "#F0FDF4", "stroke": "#79AA87"},
    "process": {"fill": "#F5F3FF", "stroke": "#9A8ACA"},
    "fusion": {"fill": "#FFF7ED", "stroke": "#D7A35C"},
    "training": {"fill": "#FFF1F2", "stroke": "#D4868D"},
    "loss": {"fill": "#FFF1F2", "stroke": "#D4868D"},
    "output": {"fill": "#ECFEFF", "stroke": "#65A9AC"},
    "graph": {"fill": "#F5F3FF", "stroke": "#9A8ACA"},
    "static": {"fill": "#F8FAFC", "stroke": "#A0A9B5"}
  },
  "group_colors": ["#EFF6FF", "#F0FDF4", "#F5F3FF", "#FFF7ED", "#FFF1F2", "#ECFEFF"],
  "edge_styles": {
    "data_flow": {"color": "#4B5563", "width": 2.0, "dashed": false},
    "control_flow": {"color": "#374151", "width": 2.2, "dashed": false},
    "residual": {"color": "#8B76B7", "width": 1.8, "dashed": false},
    "skip": {"color": "#708090", "width": 1.5, "dashed": false},
    "feedback": {"color": "#917AB8", "width": 1.7, "dashed": true},
    "training_only": {"color": "#D39A53", "width": 1.7, "dashed": true},
    "reference": {"color": "#9AA4B2", "width": 1.3, "dashed": true},
    "gradient": {"color": "#C8757A", "width": 1.6, "dashed": true}
  }
}
